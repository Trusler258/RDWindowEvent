<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>RDWindowEvent</AssemblyName>
    <RootNamespace>RDWindowEvent</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <GameDir Condition="'$(GameDir)' == ''">$(ADOFAI_GAME_DIR)</GameDir>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(GameDir)\A Dance of Fire and Ice_Data\Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RDTools">
      <HintPath>$(ManagedDir)\RDTools.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DOTween">
      <HintPath>$(ManagedDir)\DOTween.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ManagedDir)\UnityModManager\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityModManager">
      <HintPath>$(ManagedDir)\UnityModManager\UnityModManager.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckGameDir" BeforeTargets="PrepareForBuild" Condition="'$(GameDir)' == ''">
    <Error Text="未找到 ADOFAI 游戏目录。请设置环境变量 ADOFAI_GAME_DIR，或使用 dotnet build -p:GameDir=&quot;游戏目录&quot;。" />
  </Target>

  <Target Name="DeployMod" AfterTargets="Build" Condition="'$(GameDir)' != ''">
    <ItemGroup>
      <ModFiles Include="$(TargetDir)$(AssemblyName).dll" />
      <ModFiles Include="$(MSBuildProjectDirectory)\Info.json" />
    </ItemGroup>
    <MakeDir Directories="$(GameDir)\Mods\$(AssemblyName)" />
    <Copy SourceFiles="@(ModFiles)" DestinationFolder="$(GameDir)\Mods\$(AssemblyName)" />
  </Target>
</Project>
